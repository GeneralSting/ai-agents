# Kopiraj ovu datoteku u .env i upiši svoj ključ.  (.env se NE commita)
# Odaberi JEDAN provider tako da otkomentiraš njegov blok.
# Nazive modela provjeri u dokumentaciji providera, jer se često mijenjaju.

# --- Google Gemini (besplatni tier, preporuka za početak) ---
# Ključ: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=upisi-svoj-kljuc

# --- Groq (besplatni tier, vrlo brz, open-source modeli) ---
# Ključ: https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=upisi-svoj-kljuc

# --- Ollama (lokalno na tvom računalu, potpuno besplatno i privatno) ---
# Instalacija: https://ollama.com, zatim: ollama pull llama3.2
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# --- Anthropic Claude (plaća se po potrošnji) ---
# Ključ: https://platform.claude.com
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-haiku-5-5
# LLM_API_KEY=upisi-svoj-kljuc
